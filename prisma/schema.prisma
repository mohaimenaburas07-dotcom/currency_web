model ExecutionSession {
  id                     String                  @id @default(cuid())
  purchaseRequestUuid    String                  @unique @map("purchase_request_uuid")
  customerCode           String?                 @map("customer_code")
  startedByUserId        String                  @map("started_by_user_id")
  branchId               String?                 @map("branch_id")
  status                 ExecutionStatus         @default(DRAFT)
  verificationStatus     StepStatus              @default(PENDING) @map("verification_status")
  cameraStatus           StepStatus              @default(PENDING) @map("camera_status")
  countingStatus         StepStatus              @default(PENDING) @map("counting_status")
  receiptStatus          StepStatus              @default(PENDING) @map("receipt_status")
  serialNumber           String?                 @map("serial_number")
  notes                  String?
  requestSnapshot        Json?                   @map("request_snapshot")
  startedAt              DateTime                @default(now()) @map("started_at")
  endedAt                DateTime?               @map("ended_at")
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")
  usedDeviceIds          Json?                   @map("used_device_ids")
  sourceMetadata         Json?                   @map("source_metadata")
  cashCountResult        CashCountResult?
  identityVerification   IdentityVerification?
  mediaRecords           MediaRecord[]
  receipt                Receipt?
  receivedCustomerRecord ReceivedCustomerRecord?
  transactionRecord      TransactionRecord?
  auditLogs              WorkflowAuditLog[]

  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("execution_sessions")
}

model IdentityVerification {
  id                 String           @id @default(cuid())
  sessionId          String           @unique @map("session_id")
  verificationMethod String           @default("MANUAL") @map("verification_method")
  documentType       String?          @map("document_type")
  documentNumber     String?          @map("document_number")
  documentImagePath  String?          @map("document_image_path")
  matched            Boolean          @default(false)
  mismatchReason     String?          @map("mismatch_reason")
  verifiedByUserId   String           @map("verified_by_user_id")
  verifiedAt         DateTime         @default(now()) @map("verified_at")
  createdAt          DateTime         @default(now()) @map("created_at")
  session            ExecutionSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("identity_verifications")
}

model MediaRecord {
  id               String           @id @default(cuid())
  sessionId        String           @map("session_id")
  mediaType        MediaType        @map("media_type")
  filePath         String           @map("file_path")
  fileName         String           @map("file_name")
  mimeType         String?          @map("mime_type")
  fileSizeBytes    Int?             @map("file_size_bytes")
  capturedByUserId String           @map("captured_by_user_id")
  capturedAt       DateTime         @default(now()) @map("captured_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  session          ExecutionSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([mediaType])
  @@map("media_records")
}

model CashCountResult {
  id                   String                  @id @default(cuid())
  sessionId            String                  @unique @map("session_id")
  currency             String                  @default("USD")
  totalCountedAmount   Decimal                 @map("total_counted_amount") @db.Decimal(19, 2)
  deviceReference      String?                 @map("device_reference")
  excelFilePath        String?                 @map("excel_file_path")
  isMatchedWithRequest Boolean                 @default(false) @map("is_matched_with_request")
  countedAt            DateTime                @default(now()) @map("counted_at")
  createdAt            DateTime                @default(now()) @map("created_at")
  usdSerialNumbers     String[]                @default([]) @map("usd_serial_numbers")
  denominations        CashCountDenomination[]
  session              ExecutionSession        @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("cash_count_results")
}

model CashCountDenomination {
  id                String          @id @default(cuid())
  cashCountResultId String          @map("cash_count_result_id")
  denomination      Decimal         @db.Decimal(10, 2)
  notesCount        Int             @default(0) @map("notes_count")
