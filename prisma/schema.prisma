}

model TransactionRecord {
  id                     String                  @id @default(cuid())
  purchaseRequestUuid    String                  @unique @map("purchase_request_uuid")
  sessionId              String                  @unique @map("session_id")
  transactionNumber      String                  @unique @map("transaction_number")
  currency               String
  amountForeign          Decimal                 @map("amount_foreign") @db.Decimal(19, 2)
  exchangeRate           Decimal                 @map("exchange_rate") @db.Decimal(15, 6)
  amountLocal            Decimal                 @map("amount_local") @db.Decimal(19, 2)
  serialNumber           String?                 @map("serial_number")
  executedByUserId       String                  @map("executed_by_user_id")
  branchId               String?                 @map("branch_id")
  executedAt             DateTime                @default(now()) @map("executed_at")
  status                 String                  @default("COMPLETED")
  createdAt              DateTime                @default(now()) @map("created_at")
  receivedCustomerRecord ReceivedCustomerRecord?
  session                ExecutionSession        @relation(fields: [sessionId], references: [id])

  @@index([transactionNumber])
  @@map("transaction_records")
}

model ReceivedCustomerRecord {
  id                  String            @id @default(cuid())
  purchaseRequestUuid String            @unique @map("purchase_request_uuid")
  sessionId           String            @unique @map("session_id")
  transactionRecordId String            @unique @map("transaction_record_id")
  customerExternalId  String?           @map("customer_external_id")
  customerName        String            @map("customer_name")
  nationalId          String?           @map("national_id")
  passportNumber      String?           @map("passport_number")
  phone               String?
  address             String?
  requestType         String?           @map("request_type")
  currency            String
  amountForeign       Decimal           @map("amount_foreign") @db.Decimal(19, 2)
  exchangeRate        Decimal           @map("exchange_rate") @db.Decimal(15, 6)
  amountLocal         Decimal           @map("amount_local") @db.Decimal(19, 2)
  receiptNumber       String?           @map("receipt_number")
  receivedAt          DateTime          @default(now()) @map("received_at")
  receivedByUserId    String            @map("received_by_user_id")
  createdAt           DateTime          @default(now()) @map("created_at")
  session             ExecutionSession  @relation(fields: [sessionId], references: [id])
  transactionRecord   TransactionRecord @relation(fields: [transactionRecordId], references: [id])

  @@index([nationalId])
  @@index([receivedAt(sort: Desc)])
  @@map("received_customer_records")
}

model WorkflowAuditLog {
  id                String            @id @default(cuid())
  entityType        String            @map("entity_type")
  entityId          String            @map("entity_id")
  action            String
  performedByUserId String?           @map("performed_by_user_id")
  oldValuesJson     Json?             @map("old_values_json")
  newValuesJson     Json?             @map("new_values_json")
  ipAddress         String?           @map("ip_address")
  userAgent         String?           @map("user_agent")
  sessionId         String?           @map("session_id")
  createdAt         DateTime          @default(now()) @map("created_at")
  session           ExecutionSession? @relation(fields: [sessionId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt(sort: Desc)])
  @@map("workflow_audit_logs")
}

model BranchHardwareConfig {
  id         String           @id @default(cuid())
  branchCode String           @unique @map("branch_code")
  branchName String?          @map("branch_name")
  cameraIp   String?          @map("camera_ip")
  counterIp  String?          @map("counter_ip")
  printerIp  String?          @map("printer_ip")
  gatewayUrl String?          @default("http://localhost:8080") @map("gateway_url")
  
  // Camera Configuration
  cameraName         String?  @map("camera_name")
  cameraUsername     String?  @map("camera_username")
  cameraPassword     String?  @map("camera_password")
  cameraHttpPort     Int      @default(80) @map("camera_http_port")
  cameraRtspPort     Int      @default(554) @map("camera_rtsp_port")
  cameraRtspMainPath String   @default("/unicast/c1/s0/live") @map("camera_rtsp_main_path")
  cameraRtspSubPath  String   @default("/unicast/c1/s1/live") @map("camera_rtsp_sub_path")
  cameraSnapshotPath String   @default("/snap.jpg") @map("camera_snapshot_path")
  cameraEnabled      Boolean  @default(true) @map("camera_enabled")
  cameraStreamType   String   @default("snapshot") @map("camera_stream_type")

  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")
  devices    HardwareDevice[]

  @@map("branch_hardware_configs")
}

model HardwareDevice {
  id             String               @id @default(cuid())
  branchCode     String               @map("branch_code")
  name           String
  type           HardwareType
  role           String?
  connectionInfo Json                 @map("connection_info")
  isDefault      Boolean              @default(false) @map("is_default")
  status         DeviceStatus         @default(ONLINE)
  metadata       Json?
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  branchConfig   BranchHardwareConfig @relation(fields: [branchCode], references: [branchCode], onDelete: Cascade)

  @@index([branchCode])
  @@index([type])
  @@map("hardware_devices")
}

enum HardwareType {
  CAMERA
  SCANNER
  PRINTER
  COUNTER
}

enum DeviceStatus {
  ONLINE
  OFFLINE
  ERROR
  MAINTENANCE
}

enum ExecutionStatus {
  DRAFT
  VERIFYING_IDENTITY
  RECORDING
  COUNTING_CASH
  READY_FOR_CONFIRMATION
  COMPLETED
  CANCELLED
}

enum StepStatus {
  PENDING
  IN_PROGRESS
  DONE
  FAILED
}

enum MediaType {
  PHOTO
  VIDEO
  DOCUMENT
}
