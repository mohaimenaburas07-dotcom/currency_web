generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model audit_logs {
  id             BigInt    @id @default(autoincrement())
  amount         Float?
  bank_code      String?   @db.VarChar(255)
  cbs_reference  String?   @db.VarChar(255)
  error_code     String?   @db.VarChar(255)
  fcms_reference String?   @db.VarChar(255)
  iban           String?   @db.VarChar(255)
  logged_at      DateTime? @db.Timestamp(6)
  status_code    String?   @db.VarChar(255)
  status_name    String?   @db.VarChar(255)
  transaction_id String?   @db.VarChar(255)
  user_name      String?   @db.VarChar(255)
  user_nid       String?   @db.VarChar(255)
  details        String?
  phone          String?   @db.VarChar(255)
}

